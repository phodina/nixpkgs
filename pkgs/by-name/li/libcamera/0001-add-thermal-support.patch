+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2023, Thermal Camera Pipeline
+ *
+ * Thermal camera pipeline handler for Realtek 0bda:5830 USB Camera
+ */
+
+#include <algorithm>
+#include <fstream>
+#include <iostream>
+#include <memory>
+#include <vector>
+#include <sys/mman.h>
